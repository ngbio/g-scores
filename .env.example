# Copy to .env at the project root. Never commit real credentials.
# Loaded as Java properties: do not wrap values in quotes or use export.
# Escape literal backslashes as \\; prefer forward slashes in file paths.
# Local MySQL Server (Workbench is the GUI client):
DB_URL=jdbc:mysql://localhost:3306/gscores?rewriteBatchedStatements=true
DB_USERNAME=your_mysql_user
DB_PASSWORD=replace_with_your_password
# For Aiven, replace DB_URL and DB_USERNAME above using your service details:
# DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslMode=REQUIRED&rewriteBatchedStatements=true&connectTimeout=10000
# DB_USERNAME=YOUR_AIVEN_USER
# CSV path below is relative to backend/; import.ps1 resolves it automatically.
IMPORT_CSV_PATH=../dataset/diem_thi_thpt_2024.csv
IMPORT_BATCH_SIZE=500

# Backend local port. Render supplies PORT; use 10000 in Render's dashboard.
PORT=8081
# On Render, replace with your Cloudflare Pages origin (no /api or trailing /).
# Separate multiple origins with commas when you also use a custom domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Render value example: https://YOUR_CLOUDFLARE_PROJECT.pages.dev
